# ===== السيرفر (Vercel → Settings → Environment Variables) =====
# الطريقة 1 (الأسهل): محتوى ملف Service Account كامل (JSON) في سطر واحد
FIREBASE_SERVICE_ACCOUNT=
# الطريقة 2: بدل الطريقة 1 (اختياري)
# FIREBASE_PROJECT_ID=understand-me-d31f4
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# من يحق له دخول لوحة الإدارة (واحد على الأقل مطلوب)
# إيميلات المديرين (مفصولة بفاصلة) - لازم الإيميل يكون موثّق (دخول Google مثلاً)
ADMIN_EMAILS=
# أو UIDs المديرين من Firebase Authentication (أأمن)
ADMIN_UIDS=

# ===== الواجهة (اختياري - القيم الافتراضية هي إعدادات مشروعك) =====
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
