# ===== السيرفر (Vercel → Settings → Environment Variables) =====
# الطريقة 1 (الأسهل): محتوى ملف Service Account كامل (JSON) في سطر واحد
FIREBASE_SERVICE_ACCOUNT=
# الطريقة 2: بدل الطريقة 1 (اختياري)
# FIREBASE_PROJECT_ID=understand-me-d31f4
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# اختياري: UIDs مديرين إضافيين (أول حساب يُنشأ من صفحة إنشاء الحساب يكون مديرًا تلقائيًا)
ADMIN_UIDS=

# ===== الواجهة (اختياري - القيم الافتراضية هي إعدادات مشروعك) =====
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
